# Railway provides DATABASE_URL automatically once you add the Postgres plugin.
# For local dev, point at a local/dev Postgres instance.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/smart_bandobast

JWT_SECRET=change-this-to-a-long-random-string
PORT=4000

# Used to encrypt integration API keys (HERE/TomTom/Google/WhatsApp) entered
# via the in-app Settings screen. Must be a 64-char hex string (32 bytes).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Losing/rotating this key invalidates previously saved settings — they'd
# need to be re-entered.
SETTINGS_ENCRYPTION_KEY=

# Comma-separated list of allowed frontend origins (Vercel URL + localhost for dev)
CORS_ORIGIN=http://localhost:5173
